# Copy to ./uti260b.toml or ~/.config/uti260b/config.toml.
# While joined to the camera's AP, "auto" resolves the default gateway,
# which is the camera itself. Override with an explicit address if needed.
[camera]
ip = "auto"
live_port = 9527
connect_timeout_ms = 2000
read_timeout_ms = 2000
target_fps = 20
out_dir = "captures"

# AUTORUN.INF marker used to recognise the camera's USB volume. Change this
# for another model whose label differs.
[usb]
marker = "UNIT UTi260B+"
